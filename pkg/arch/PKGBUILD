# Builds gpui-greeter from the repository this file lives in:
#
#   cd pkg/arch && makepkg -si

pkgname=gpui-greeter-git
_name=gpui-greeter
pkgver=0.1.0.r7.gd329c88
pkgrel=1
pkgdesc='A greeter for greetd on X11, drawn with GPUI'
arch=(x86_64)
# No licence is chosen yet; the bundled fonts are under the SIL Open Font
# License, whose texts are installed with them.
license=()
depends=(
    bash
    glibc
    greetd
    greetd-agreety
    libgcc
    libxcb
    libxkbcommon
    libxkbcommon-x11
    pam
    systemd
    vulkan-driver
    vulkan-icd-loader
    xorg-server
    xorg-xinit
)
makedepends=(cargo git)
optdepends=(
    'accountsservice: avatars, and the session LightDM last used, before the first login here'
    'polkit: gpui-greeter settings asks for the password to apply what root keeps'
    'xdg-desktop-portal: the file dialogs of gpui-greeter settings'
    'noto-fonts-cjk: Chinese text'
    'xorg-server-xvfb: gpui-greeter preview --shot, without a display'
    'vulkan-swrast: drawing previews on the CPU (lavapipe)'
    'xss-lock: gpui-greeter lock on suspend and when idle'
)
provides=("$_name" greetd-greeter)
conflicts=("$_name")
backup=("etc/$_name/config.toml" "etc/greetd/$_name.toml" "etc/pam.d/$_name-lock")
install=$_name.install
source=("$_name::git+file://${startdir%/pkg/arch}#branch=main")
# Once the repository is published:
# source=("$_name::git+https://example.org/$_name.git#branch=main")
sha256sums=('SKIP')

pkgver() {
    cd "$_name"
    local version
    version=$(sed -n 's/^version = "\(.*\)"$/\1/p' Cargo.toml | head -1)
    printf '%s.r%s.g%s' "$version" "$(git rev-list --count HEAD)" "$(git rev-parse --short=7 HEAD)"
}

prepare() {
    cd "$_name"
    export RUSTUP_TOOLCHAIN=stable
    cargo fetch --locked --target "$(rustc --print host-tuple)"
}

build() {
    cd "$_name"
    export RUSTUP_TOOLCHAIN=stable
    export CARGO_TARGET_DIR="$srcdir/target"
    # Paths in panic messages name the source, not this build's directory.
    export RUSTFLAGS="${RUSTFLAGS-} --remap-path-prefix=$srcdir=/"
    cargo build --frozen --release
}

package() {
    cd "$_name"
    install -Dm755 "$srcdir/target/release/$_name" "$pkgdir/usr/bin/$_name"
    install -Dm755 "dist/$_name-switch" "$pkgdir/usr/bin/$_name-switch"
    install -Dm644 dist/config.toml "$pkgdir/etc/$_name/config.toml"
    install -Dm644 dist/greetd.toml "$pkgdir/etc/greetd/$_name.toml"
    install -Dm644 dist/lock.pam "$pkgdir/etc/pam.d/$_name-lock"
    install -Dm644 dist/greetd-service.conf \
        "$pkgdir/usr/lib/systemd/system/greetd.service.d/$_name.conf"
    install -Dm644 dist/tmpfiles.conf "$pkgdir/usr/lib/tmpfiles.d/$_name.conf"
    install -Dm644 "dist/$_name-settings.desktop" \
        "$pkgdir/usr/share/applications/$_name-settings.desktop"
    install -Dm644 README.md "$pkgdir/usr/share/doc/$_name/README.md"
    install -Dm644 -t "$pkgdir/usr/share/licenses/$pkgname" assets/fonts/OFL-*.txt
    # The skill for designing themes with an agent, and its example theme.
    local file
    while IFS= read -r -d '' file; do
        install -Dm644 "$file" "$pkgdir/usr/share/$_name/$file"
    done < <(find skills -type f -print0)
    install -Dm644 skills/gpui-greeter-theme/dial/fonts/OFL.txt \
        "$pkgdir/usr/share/licenses/$pkgname/OFL-NotoSerifDisplay.txt"
}
